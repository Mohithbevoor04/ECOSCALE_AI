# =========================================================================
# ECOSCALE AI REAL-TIME LIVE ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in your real API credentials below.
# =========================================================================

# 1. GOOGLE GEMINI AI API KEY (For Real AI Copilot & XAI Explanations)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_ACTUAL_GEMINI_API_KEY"

# 2. REAL AWS CLOUD CREDENTIALS (For Real EC2 & CloudWatch Ingestion)
# Create an IAM User with AmazonEC2ReadOnlyAccess & CloudWatchReadOnlyAccess policies
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# Optional session token (required ONLY for AWS Academy / Starter accounts)
AWS_SESSION_TOKEN=""

# 3. ELECTRICITY MAPS REAL-TIME CARBON API (For Real Power Grid Data)
# Get a free API key at: https://www.electricitymaps.com/free-tier-api
ELECTRICITY_MAPS_API_KEY="YOUR_ELECTRICITY_MAPS_TOKEN"

# 4. GITHUB GITOPS PR AUTOMATION (For Real GitHub Pull Request Creation)
# Create a Personal Access Token (PAT) with 'repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
GITHUB_REPO="Mohithbevoor04/ECOSCALE_AI"
